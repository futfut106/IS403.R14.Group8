{
  "python": "3.12.10",
  "platform": "Windows-11-10.0.26200-SP0",
  "packages": {
    "numpy": "2.5.3",
    "pandas": "3.0.5",
    "scipy": "1.18.1",
    "scikit-learn": "1.9.1",
    "xgboost": "3.4.1",
    "matplotlib": "3.11.2",
    "joblib": "1.6.0",
    "threadpoolctl": "3.7.0"
  },
  "protocol": {
    "series_file": "statewide_monthly.csv generated by preparation",
    "columns": [
      "date",
      "bev",
      "phev",
      "ev_total",
      "non_ev",
      "total_vehicles",
      "ev_pct",
      "split"
    ],
    "target": "ev_total",
    "target_unit": "vehicles at month end",
    "first_month": "2017-01-31",
    "last_month": "2023-11-30",
    "train_end": "2022-11-30",
    "test_start": "2022-12-31",
    "horizon": 12,
    "cv_train_months": [
      47,
      53,
      59
    ],
    "cv_origins": [
      "2020-11-30",
      "2021-05-31",
      "2021-11-30"
    ],
    "ml_features": [
      "r_lag_1",
      "r_lag_2",
      "r_lag_3",
      "r_mean_3",
      "r_mean_6"
    ],
    "ml_target": "ln(y_t) - ln(y_(t-1)); not multiplied by 100",
    "forecast_strategy": "fixed origin; no updates with test actuals",
    "metrics": [
      "rmse",
      "mae",
      "smape",
      "bias"
    ],
    "bias_definition": "mean(actual - pred)",
    "smape_definition": "mean(200 * abs(actual-pred) / (abs(actual)+abs(pred))); 0 contribution when both are 0",
    "rounding": "none before CSV export, selection or scoring",
    "prediction_interval_alpha": 0.05,
    "seed": 42
  },
  "feature_names": [
    "r_lag_1",
    "r_lag_2",
    "r_lag_3",
    "r_mean_3",
    "r_mean_6"
  ],
  "selection_locked_before_test": true,
  "full_train_supervised_rows": 64,
  "validation_supervised_rows": [
    40,
    46,
    52
  ],
  "n_candidate_fits": 81,
  "prediction_intervals": "not_estimated",
  "random_seed": 42,
  "notes": [
    "No test update or test-based hyperparameter selection.",
    "Validation windows overlap; fold scores are not independent samples.",
    "Feature importances are training-model summaries, not causal effects.",
    "This runner compares configurations within each family; final cross-family comparison is separate."
  ]
}
